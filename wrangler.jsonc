{
  "name": "learn-inside",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    // 全站接口 /api（账号、会员、支付）、数学 /math/api 和旧地址 /amc8 经过 Worker，其他请求直接出静态文件
    "run_worker_first": ["/api/*", "/math/api/*", "/amc8", "/amc8/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "amc8-mock",
      "database_id": "0776ad4b-3605-4f67-a555-312bec426720"
    }
  ],
  "vars": {
    "FREE_MODE": "true",       // 试用期全部内容免费；收费时改为 "false"
    "INVITE_CODES": "AMC2026", // 旧的邀请码加入（现在用手机号注册）；逗号分隔，留空 = 不需要邀请码
    // 会员价格（元），留空显示“价格待定”：PRICE_<数学 MATH / 全科 ALL / 语文 CHINESE>_<MONTH / QUARTER / YEAR>
    "PRICE_MATH_MONTH": "", "PRICE_MATH_QUARTER": "", "PRICE_MATH_YEAR": "",
    "PRICE_ALL_MONTH": "", "PRICE_ALL_QUARTER": "", "PRICE_ALL_YEAR": "",
    "PAY_CONTACT": ""          // 在线支付开通前，账号页显示的购买激活码联系方式，比如“微信 xxx”
    // 支付宝：ALIPAY_APP_ID 在控制台加变量；ALIPAY_PRIVATE_KEY、ALIPAY_PUBLIC_KEY 必须用 Secret，不要写进这里（见 amc8-src/README.md）
  }
}
