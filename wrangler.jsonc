{
  "name": "learn-inside",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    // 只有奥数（/math）的 API 和旧地址 /amc8 经过 Worker，学习页等其他请求直接出静态文件
    "run_worker_first": ["/math/api/*", "/amc8", "/amc8/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "amc8-mock",
      "database_id": "0776ad4b-3605-4f67-a555-312bec426720"
    }
  ],
  "vars": {
    "FREE_MODE": "true",       // 试用期全部内容免费；收费时改为 "false"
    "INVITE_CODES": "AMC2026", // 旧的邀请码加入（现在用手机号注册）；逗号分隔，留空 = 不需要邀请码
    // 会员价格（元），留空显示“价格待定”
    "PRICE_MONTH": "",
    "PRICE_QUARTER": "",
    "PRICE_YEAR": "",
    "PAY_CONTACT": ""          // 在线支付开通前，账号页显示的购买激活码联系方式，比如“微信 xxx”
  }
}
