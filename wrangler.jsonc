{
  "name": "learn-inside",
  // 部署时保留控制台里加的变量（价格、支付宝 APPID 等），不被这个文件覆盖
  "keep_vars": true,
  "main": "worker/index.js",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    // 全站接口 /api（账号、会员、支付）、数学 /math/api 和旧地址 /amc8 经过 Worker，其他请求直接出静态文件
    "run_worker_first": ["/api/*", "/math/api/*", "/math/admin.html", "/math/members.html", "/amc8", "/amc8/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "amc8-mock",
      "database_id": "0776ad4b-3605-4f67-a555-312bec426720"
    }
  ],
  "vars": {
    "FREE_MODE": "true",       // 试用期全部内容免费；收费时改为 "false"
    "INVITE_CODES": "AMC2026"  // 旧的邀请码加入（现在用手机号注册）；逗号分隔，留空 = 不需要邀请码
    // 会员价格不写在这里，在 Cloudflare 控制台加变量 PRICE_<MATH / ALL / CHINESE>_<MONTH / QUARTER / YEAR>（元），没设的显示“价格待定”
    // 支付宝：在控制台加 AIPAY_APP_ID（变量）、AIPAY_PRIVATE_KEY 和 AIPAY_ALIPAY_PUBLIC_KEY（Secret），不要写进这里（见 backend/README.md）
  }
}
